{
  "$schema": "https://opencode.ai/config.json",
  // nicely-specified paths: relative to this config, ~/ for home, or owner/repo for git
  "references": {
    "docs": {
      "path": "~/documents",
      "description": "Use for project docs and notes"
    },
    "dotfiles": {
      "path": "~/dotfiles",
      "description": "Use for shell and editor config"
    }
  },
  "skills": {
    "paths": ["~/.config/opencode/skills"]
  },
  "permission": "allow"
}